<div class="contact">

    {% if status == 'failed' %}

        <p>{{ translate('contact', 'messageFailed') }}</p>
        <p><a href="{{ url_rel(route) }}" class="contact-button pure-button">{{ translate('contact', 'backToForm') }}</a></p>

    {% elseif status == 'successful' %}

        <p>{{ translate('contact', 'messageSuccessful') }}</p>
        <p><a href="{{ url_rel(route) }}" class="contact-button pure-button">{{ translate('contact', 'backToForm') }}</a></p>

    {% else %}

        {% if errors %}

            <div class="contact-errors">{{ translate('contact', 'messageError') }}</div>

        {% endif %}

        <form class="contact-form pure-form pure-form-stacked" action="{{ url_rel(route) }}" method="post">
            <div class="contact-control-group pure-control-group{% if errors.name %} contact-control-group-error{% endif %}">
                <label for="name">{{ translate('contact', 'labelName') }}</label>
                <input class="contact-input pure-input-1" id="name" name="name" type="text" placeholder="" value="{{ data.name }}">
                {% if errors.name %}
                    <span class="contact-form-message pure-form-message is-error">{{ errors.name }}</span>
                {% endif %}
            </div>

            <div class="contact-control-group pure-control-group{% if errors.email %} contact-control-group-error{% endif %}">
                <label for="email">{{ translate('contact', 'labelEmail') }}</label>
                <input class="contact-input pure-input-1" id="email" name="email" type="email" placeholder="" value="{{ data.email }}">
                {% if errors.email %}
                    <span class="contact-form-message pure-form-message is-error">{{ errors.email }}</span>
                {% endif %}
            </div>

            <div class="contact-control-group pure-control-group{% if errors.message %} contact-control-group-error{% endif %}">
                <label for="message">{{ translate('contact', 'labelMessage') }}</label>
                <textarea class="contact-input pure-input-1" id="message" name="message" placeholder="" rows="5">{{ data.message }}</textarea>
                {% if errors.message %}
                    <span class="contact-form-message pure-form-message is-error">{{ errors.message }}</span>
                {% endif %}
            </div>

            <div class="contact-control-group contact-control-group-antispam pure-control-group{% if errors.antispam %} contact-control-group-error{% endif %}">
                <label for="antispam">{{ translate('contact', 'labelAntispam') }}</label>
                <input class="contact-input pure-input-1" id="antispam" name="antispam" type="text" placeholder="" value="{{ data.antispam }}">
                {% if errors.antispam %}
                    <span class="contact-form-message pure-form-message is-error">{{ errors.antispam }}</span>
                {% endif %}
            </div>

            <div class="contact-controls pure-controls">
                <button type="submit" name="button" value="submit" class="contact-button pure-button">{{ translate('contact', 'buttonSubmit') }}</button>
                {% if data.message or data.name or data.email %}
                    <button type="submit" name="button" value="reset" class="contact-button contact-secondary-button pure-button">{{ translate('contact', 'buttonReset') }}</button>
                {% endif %}
            </div>
        </form>

    {% endif %}

</div>

<style>
    .contact-errors {
        font-size: 0.9em;
        background: rgb(232, 90, 90);
        color: white;
        padding: 1em;
        margin-bottom: 1em;
    }
    .contact-form-message.is-error {
        color: rgb(232, 90, 90);
    }
    .contact-control-group {
        margin-bottom: 1em;
    }
    .contact-control-group-antispam {
        display: none;
    }
    .contact-secondary-button {
        background-color:#e6e6e6;
        color:#666;
    }
</style>
