<div class="plugin-search-form">
    <form action="{{ page_url(route) }}" method="get">
        <input type="text" name="query" value="{{ query }}" {% if not query %}autofocus{% endif %}>
        <input type="submit" value="{{ translate('search', 'search') }}">
        <label class="search-exact">
            <input type="checkbox" name="exact" value="1" {% if exact %}checked{% endif %}>
            {{ translate('search', 'exactMatch') }}
        </label>
    </form>
</div>
