{% if submitted %}
<div class="plugin-search-results">
    {% if query == false %}
        <p>{{ translate('search', 'pleaseEnterASearchTerm') }}</p>
    {% elseif results|length == 0 %}
        <p>{{ translate('search', 'noResultsFoundForQuery', {query: query}) }}</p>
    {% else %}
        <p>{{ translate('search', 'countResultsFound', {count: results|length}) }}</p>
        {% for result in results %}
            <div class="result">
                <div class="title">{{ page_link(result.route, result.title) }}</div>
                <div class="url">{{ page_url(result.route) }}</div>
                {% if result.snippet %}
                    <div class="snippet">
                        {% if result.date %}<span class="date">{{ result.date|date('d. M Y') }}</span> — {% endif %}
                        {{ result.snippet|raw }}
                    </div>
                {% elseif result.date %}
                    <div class="date">{{ result.date|date('d. M Y') }}</div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endif %}
