{% if submitted %}
<div class="plugin-search-results">
    {% if query == false %}
        <p>{{ translate('search', 'pleaseEnterASearchTerm') }}</p>
    {% elseif results|length == 0 %}
        <p>{{ translate('search', 'noResultsFoundForQuery', {query: query}) }}</p>
    {% else %}
        <p>{{ translate('search', 'countResultsFound', {count: results|length}) }}</p>
        {% for result in results %}
            <div class="result">
                <div class="title">{{ link_page(result.route, result.title) }}</div>
                <div class="url">{{ url_rel(result.route) }}</div>
                {% if result.date %}
                    <div class="date">{{ result.date|date('d. F Y') }}</div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endif %}
