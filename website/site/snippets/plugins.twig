<div class="plugins">
    {% set plugins = query(site.data.plugins).where('enabled=true').order('id').all() %}
    <p>There are currently <b>{{ plugins|length }}</b> plugins available.</p>
    {% for item in plugins %}
        {% if item.enabled == true %}
        <div class="plugin">
            <p><strong>{{ attribute(item, 'name') }}</strong></p>
            <p>{{ attribute(item, 'desc') }}</p>
            {% if item.composer %}
                <table>
                    <tr>
                        <td style="white-space:nowrap">Composer</td>
                        <td>{{ item.composer }}</td>
                    </tr>
                </table>
            {% endif %}
            <p class="links">
                {% if item.github %}
                    <a class="plugin-link" target="_blank" href="{{ item.github }}">
                        {{ icon('github') }} GitHub
                    </a>
                {% endif %}
                {% if item.packagist %}
                    <a class="plugin-link" target="_blank" href="{{ item.packagist }}">
                        {{ icon('archive-fill') }} Packagist
                    </a>
                {% endif %}
            </p>
        </div>
        {% endif %}
    {% endfor %}
</div>
