<table class="pure-table pure-table-horizontal">
    <thead>
    <tr>
        <th style="width:25%">Variable</th>
        <th style="width:65%">Description</th>
        <th style="width:10%">Type</th>
    </tr>
    </thead>
    {% for data in attribute(site.data, type) %}
        <tr>
            <td>{{ data.name }}</td>
            <td>{{ data.desc|markdown }}</td>
            <td>{{ data.type }}</td>
        </tr>
    {% endfor %}
</table>
