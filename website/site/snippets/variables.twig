{% set typeFirst = typeFirst|default(false) %}
<table class="pure-table pure-table-horizontal">
    <thead>
    <tr>
        <th>Variable</th>
        {% if typeFirst %}
        <th>Type</th>
        <th>Description</th>
        {% else %}
        <th>Description</th>
        <th>Type</th>
        {% endif %}
    </tr>
    </thead>
    {% for data in attribute(site.data, type) %}
        <tr>
            <td>{{ data.name }}</td>
            {% if typeFirst %}
            <td>{{ data.type }}</td>
            <td>{{ data.desc|markdown }}</td>
            {% else %}
            <td>{{ data.desc|markdown }}</td>
            <td>{{ data.type }}</td>
            {% endif %}
        </tr>
    {% endfor %}
</table>
