{% apply spaceless %}
    {{ css_add('@theme/css/purecss@3.0.0-pure.min.css') }}
    {{ css_add('@theme/css/purecss@3.0.0-grids-responsive.min.css') }}
    {{ css_add('@theme/css/highlight-stackoverflow-light@11.6.0.min.css') }}
    {{ css_add('@theme/css/styles.css') }}
    {{ js_add('@theme/js/highlight@11.6.0.min.js') }}
    {{ js_add('@theme/js/highlight-apache@11.6.0.min.js') }}
    {{ js_add('@theme/js/highlight-twig@11.6.0.min.js') }}
    {{ js_add('@theme/js/scripts.js') }}

{% macro tree(nodes, currentRoute, level) %}
    {% import _self as mobile_menu %}
    {% for node in nodes %}
        {% set item = node.getMenuItem() %}
        {% if item is not null and not item.getHidden() %}
            {% set childCount = 0 %}
            {% for child in node %}
                {% if not child.getMenuItem().getHidden() %}
                    {% set childCount = childCount + 1 %}
                {% endif %}
            {% endfor %}
            {% set nodeRoute = item.getRoute() %}
            {% set isCurrent = nodeRoute == currentRoute %}
            {% set isActive = isCurrent or (nodeRoute != '' and (currentRoute starts with nodeRoute ~ '/')) %}
            <li class="mobile-nav-item{{ isActive ? ' is-active' : '' }}{{ childCount > 0 ? ' has-children' : '' }}" style="--level:{{ level }}">
                <a class="mobile-nav-link{{ isCurrent ? ' is-current' : '' }}" href="{{ url_rel(nodeRoute) }}">{{ item.getMenuTitle() ?: item.getTitle() }}</a>
                {% if childCount > 0 %}
                    <ul class="mobile-nav-children">
                        {{ mobile_menu.tree(node, currentRoute, level + 1) }}
                    </ul>
                {% endif %}
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}
{% endapply %}
<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <script>
        (function () {
            var theme = localStorage.getItem('herbie-theme');
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta charset="utf-8">
    <meta name="description" content="Herbie is a blazing fast, lightweight, flat-file CMS built with PHP and Twig. Documentation, plugins, and examples.">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    {# the icons live in the web root next to index.php, independent of the route #}
    <link rel="icon" href="{{ (site.base_url ~ '/favicon.svg')|replace({'//': '/'}) }}" type="image/svg+xml">
    <link rel="alternate icon" href="{{ (site.base_url ~ '/favicon.ico')|replace({'//': '/'}) }}" sizes="16x16">
    <title>{{ page_title(delimiter: ' / ', site_title: 'Herbie CMS', root_title: 'Herbie CMS - A simple flat-file content management system', reverse: true) }}</title>
    <base href="{{ site.base_url }}">
    {{ css_out(timestamp: true) }}
</head>
<body class="{{ css_classes() }}">
<div class="header">
    <div class="container">
        <div class="inner-container">
            <div class="pure-hidden-tablet pure-hidden-desktop">
                <a href="#menu" id="menuLink" class="menu-link" aria-label="Open navigation menu">
                    <!-- Hamburger icon -->
                    <span></span>
                </a>
            </div>
            <div class="pure-g">
                <div class="pure-u-3-5 pure-u-md-1-5">
                    <div class="brand-title">{{ link_page('index', icon('herbie') ~ ' Herbie CMS') }}</div>
                </div>
                <div class="pure-u-2-5 pure-u-md-4-5 text-right pure-hidden-phone">
                    <div class="topmenu" id="topmenu">
                        <div id="topmenu-inner">
                            <div class="pure-menu pure-menu-horizontal">
                                <ul class="pure-menu-list">
                                    {% for item in site.data.menu %}
                                        {% set active = (item.route == route) ? 'pure-menu-selected' : '' %}
                                        <li class="pure-menu-item {{ active }}">
                                            {{ link_page(item.route, item.label, {class: 'pure-menu-link'}) }}
                                        </li>
                                    {% endfor %}
                                    <li class="pure-menu-item theme-toggle-item">
                                        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
                                            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                                                <circle cx="12" cy="12" r="4"></circle>
                                                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
                                            </svg>
                                            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                            </svg>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="mobile-nav" class="mobile-nav" aria-hidden="true">
    {% import _self as mobile_menu %}
    <div class="mobile-nav-head">
        <span class="mobile-nav-title">Navigation</span>
        <button type="button" class="mobile-nav-close" aria-label="Close navigation">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <nav class="mobile-nav-body" aria-label="Main navigation">
        <ul class="mobile-nav-list">
            {{ mobile_menu.tree(site.page_tree, route, 0) }}
        </ul>
    </nav>
    <div class="mobile-nav-foot">
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </button>
    </div>
</div>

{% if page.hero %}
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-content">
                    <p class="hero-eyebrow">{{ page.hero.eyebrow }}</p>
                    <h1 class="hero-title">{{ page.hero.title }}</h1>
                    <p class="hero-subtitle">{{ page.hero.subtitle }}</p>
                    <div class="hero-actions">
                        <a class="pure-button hero-button" href="{{ url_rel(page.hero.primary_route) }}">{{ page.hero.primary_label }}</a>
                        <a class="hero-button hero-button-secondary" href="{{ page.hero.secondary_url }}">{{ page.hero.secondary_label }}</a>
                        <a class="hero-button hero-button-tertiary" href="{{ page.hero.tertiary_url }}" aria-label="{{ page.hero.tertiary_label }}">{{ icon('github', 20, 20) }}</a>
                    </div>
                    <div class="hero-badges">
                        {% for badge in page.hero.badges %}
                            <a href="{{ badge.url }}"><img src="{{ badge.image }}" alt="{{ badge.alt }}"></a>
                        {% endfor %}
                    </div>
                </div>
                <div class="hero-code" aria-hidden="true">
                    <div class="hero-code-bar">
                        <span></span><span></span><span></span>
                        <em>page.md</em>
                    </div>
                    <pre><code>---
title: Hello
---
# Hello world</code></pre>
                </div>
            </div>
        </div>
    </section>
{% endif %}

{% if page.slider %}
    <div class="pure-g slider">
        <div class="container">
            <div class="pure-g">
                <div class="pure-u-1">
                    <h2 class="brand-tagline">{{ page.slider|raw }}</h2>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<main id="main-content">
{% block content %}{% endblock %}
</main>

<div class="footer">
    <div class="container">
        <div class="pure-g">
            <div class="pure-u-1 pure-u-md-3-8 footer-about">
                <h3>About Herbie</h3>
                <p>Herbie is a blazing fast, lightweight, and highly customizable flat-file Content Management System (CMS) running on PHP, Twig, Markdown, Textile, reStructuredText, and other human-readable text files.</p>
            </div>
            <div class="pure-u-1 pure-u-md-1-8"></div>
            <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4 footer-links">
                <h3>Links</h3>
                <ul>
                    <li>{{ link_page('sitemap', 'Sitemap') }}</li>
                    <li>{{ link_page('search', 'Search') }}</li>
                    <li>{{ link_page('contact', 'Contact') }}</li>
                    <li>{{ link_page('privacy-policy', 'Privacy Policy') }}</li>
                    <li>{{ link_page('imprint', 'Imprint') }}</li>
                </ul>
            </div>
            <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4">
                <h3>Code</h3>
                <ul>
                    <li>{{ link_page('https://github.com/getherbie/herbie', 'Herbie at GitHub') }}</li>
                    <li>{{ link_page('https://packagist.org/packages/getherbie/herbie', 'Herbie at Packagist') }}</li>
                </ul>
            </div>
        </div>
        <hr>
        <div class="pure-g">
            <div class="pure-u-1-2 footer-copyright">Made with 🍫 in Switzerland</div>
            <div class="pure-u-1-2 footer-copyright text-right">A (not so) tiny <a href="https://www.tebe.ch">tebe.ch</a> project</div>
        </div>
    </div>
</div>
{{ js_out(timestamp: true) }}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('pre code[class*=language-]').forEach((el) => {
      hljs.highlightElement(el);
    });
  });
</script>
</body>
