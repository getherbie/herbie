{# render error according error code #}
{% if error.code == 404 %}

    <h1>Page not found</h1>
    <p>Oops, something went wrong. The page you requested could not be found.</p>
    <p>You can go back to the <a href="{{ url_rel('/') }}">homepage</a> or use the <a href="{{ url_rel('search') }}">search</a>.</p>

{% else %}

    <h1>Server Error</h1>
    <p>An error occurred.</p>

{% endif %}

{# render error details in debug mode only #}

{% if herbie_debug() %}

    <table class="pure-table pure-table-horizontal" style="table-layout: fixed;">
        <tr>
            <td style="width:10%">Code</td>
            <td style="width:90%">{{ error.code }}</td>
        </tr>
        <tr>
            <td>Message</td>
            <td>{{ error.message }}</td>
        </tr>
        <tr>
            <td>File</td>
            <td>{{ error.file }}</td>
        </tr>
        <tr>
            <td>Line</td>
            <td>{{ error.line }}</td>
        </tr>
        <tr>
            <td>Trace</td>
            <td>
                <div style="white-space: pre;overflow:auto">{{ error.traceAsString }}</div>
            </td>
        </tr>
    </table>
{% endif %}
